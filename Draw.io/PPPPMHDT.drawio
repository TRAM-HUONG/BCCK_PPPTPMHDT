        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Sinh viên\&quot; as Student\nactor \&quot;Giảng viên / Cố vấn học tập\&quot; as Lecturer\nactor \&quot;Quản trị viên (Admin)\&quot; as Admin\n\nrectangle \&quot;Hệ thống Trợ lý Lập Kế Hoạch Học Tập\&quot; {\n    package \&quot;Chức năng Sinh viên\&quot; {\n        usecase \&quot;US01: Đăng nhập &amp; Quản lý tài khoản\&quot; as US01\n        usecase \&quot;US02: Tra cứu chương trình đào tạo\&quot; as US02\n        usecase \&quot;US03: Lập kế hoạch học tập tự động\&quot; as US03\n        usecase \&quot;US04: Mô phỏng kịch bản lập kế hoạch\&quot; as US04\n        usecase \&quot;US05: Xem giải thích chi tiết\&quot; as US05\n        usecase \&quot;US06: Lưu trữ &amp; Gửi kế hoạch\&quot; as US06\n    }\n\n    package \&quot;Chức năng Giảng viên / Cố vấn\&quot; {\n        usecase \&quot;US07: Tra cứu danh sách sinh viên\&quot; as US07\n        usecase \&quot;US08: Xem kế hoạch học tập của sinh viên\&quot; as US08\n        usecase \&quot;US09: Phê duyệt hoặc Góp ý kế hoạch\&quot; as US09\n        usecase \&quot;US10: Xem kết quả mô phỏng &amp; giải thích\&quot; as US10\n    }\n\n    package \&quot;Chức năng Quản trị viên\&quot; {\n        usecase \&quot;US11: Quản lý người dùng\&quot; as US11\n        usecase \&quot;US12: Quản lý chương trình đào tạo\&quot; as US12\n        usecase \&quot;US13: Cấu hình quy tắc tiên quyết\&quot; as US13\n        usecase \&quot;US14: Quản lý dữ liệu học tập chung\&quot; as US14\n    }\n}\n\n&#39; Liên kết Actor Sinh viên\nStudent --&gt; US01\nStudent --&gt; US02\nStudent --&gt; US03\nStudent --&gt; US04\nStudent --&gt; US05\nStudent --&gt; US06\n\n&#39; Liên kết Actor Giảng viên\nLecturer --&gt; US07\nLecturer --&gt; US08\nLecturer --&gt; US09\nLecturer --&gt; US10\n\n&#39; Liên kết Actor Quản trị viên\nAdmin --&gt; US11\nAdmin --&gt; US12\nAdmin --&gt; US13\nAdmin --&gt; US14\n\n@en