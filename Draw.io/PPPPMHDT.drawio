        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam BoxPadding 10\nskinparam ParticipantPadding 10\nskinparam ParticipantBackgroundColor #EAEAF2\nskinparam ParticipantBorderColor #7F7F99\n\nparticipant \&quot;Admin\&quot; as Admin\nparticipant \&quot;FrmResetMatKhau\&quot; as FrmReset\nparticipant \&quot;AuthService\&quot; as AuthService\nparticipant \&quot;EmailService\&quot; as EmailService\ndatabase \&quot;SQL Server\&quot; as SQLServer\n\n== Quá trình Reset Mật khẩu Sinh viên ==\nAdmin -&gt; FrmReset: Chọn chức năng reset mật khẩu\nactivate FrmReset\n\nFrmReset --&gt; Admin: Hiển thị giao diện quản lý\ndeactivate FrmReset\n\nAdmin -&gt; FrmReset: Chọn lớp cần quản lý\nactivate FrmReset\nFrmReset -&gt; SQLServer: Truy vấn danh sách sinh viên theo lớp\nactivate SQLServer\nSQLServer --&gt; FrmReset: Trả về danh sách sinh viên\ndeactivate SQLServer\nFrmReset --&gt; Admin: Hiển thị danh sách sinh viên\ndeactivate FrmReset\n\nAdmin -&gt; FrmReset: Chọn sinh viên cần reset mật khẩu\nactivate FrmReset\nFrmReset --&gt; Admin: Hiển thị trang/giao diện reset\ndeactivate FrmReset\n\nAdmin -&gt; FrmReset: Nhập/Đổi mật khẩu mới cho sinh viên\nactivate FrmReset\nFrmReset -&gt; AuthService: Gửi yêu cầu cập nhật mật khẩu mới\nactivate AuthService\n\nAuthService -&gt; SQLServer: Lưu cập nhật mật khẩu vào cơ sở dữ liệu\nactivate SQLServer\nSQLServer --&gt; AuthService: Cập nhật thành công\ndeactivate SQLServer\n\nAuthService -&gt; EmailService: Yêu cầu gửi email thông báo mật khẩu mới cho sinh viên\nactivate EmailService\nEmailService --&gt; AuthService: Gửi email thành công\ndeactivate EmailService\n\nAuthService --&gt; FrmReset: Trả về kết quả thành công\ndeactivate AuthService\n\nFrmReset --&gt; Admin: Hiển thị thông báo thành công &amp; hoàn tất quá trình\ndeactivate FrmReset\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6frlLOdbOxLSPbqMtv3r-397">
